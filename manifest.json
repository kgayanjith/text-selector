{
  "manifest_version": 3,
  "name": "Text Selector",
  "version": "1.1",
  "description": "Forces text selection on pages that block it",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
 "action": {
  "default_icon": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png"
  }
},
"icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}